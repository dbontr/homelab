FROM golang:1.27.3-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY cmd ./cmd
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/polynomial-verifier ./cmd/polynomial-verifier

FROM scratch
COPY --from=builder /out/polynomial-verifier /polynomial-verifier
USER 65532:65532
ENTRYPOINT ["/polynomial-verifier"]
